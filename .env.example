# ---------- FundFlow environment (hackathon demo) ----------
# All values below are OPTIONAL. FundFlow runs fully self-contained without
# any external provider: STT/vision/reasoning fall back to deterministic
# local mocks so the demo never fabricates output and never requires keys.

# Recommended provider order for speech-to-text (comma separated).
# If no key is configured for a provider it is skipped at runtime.
VOICE_STT_ORDER=addis,google,local_whisper

# Recommended provider order for reasoning/LLM (comma separated).
REASONING_ORDER=primary,groq,openrouter,local

# Addis AI (primary STT + reasoning) — see challenge provider pack.
ADDIS_STT_API_KEY=
ADDIS_STT_BASE_URL=
ADDIS_STT_MODEL=
ADDIS_REASONING_API_KEY=
ADDIS_REASONING_BASE_URL=
ADDIS_REASONING_MODEL=

# Google/Gemini STT + Gemini reasoning.
GOOGLE_STT_API_KEY=
GOOGLE_STT_LANGUAGE=
GOOGLE_REASONING_API_KEY=

# Groq / OpenRouter reasoning fallbacks.
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Telegram bot. When set, the webhook route becomes active and replies are
# sent through the Bot API. Without it the webhook route returns 403.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# FundFlow configuration
FUNDFLOW_FINAL_SLOTS=5
FUNDFLOW_ENV=demo